{
  "manifest_version": 3,
  "name": "SwiftGet Integration",
  "version": "1.1.0",
  "description": "Sends browser downloads and videos playing on web pages to the SwiftGet download manager.",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "action": {
    "default_title": "SwiftGet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["downloads", "cookies", "contextMenus", "webRequest", "storage", "tabs"],
  "host_permissions": ["<all_urls>"]
}
